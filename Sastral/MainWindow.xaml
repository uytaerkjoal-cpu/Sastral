<Window x:Class="Sastral.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sastral" Height="600" Width="950" 
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <PathGeometry x:Key="AtomOrbitPath">
            <PathFigure StartPoint="100, 10" IsClosed="True">
                <ArcSegment Point="100, 190" Size="35, 90" SweepDirection="Clockwise" />
                <ArcSegment Point="100, 10" Size="35, 90" SweepDirection="Clockwise" />
            </PathFigure>
        </PathGeometry>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="hoverBg" Background="#1E60B4" Width="26" Height="26" CornerRadius="13" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="pressedBg" Background="#15427D" Width="26" Height="26" CornerRadius="13" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBg" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="hoverBg" Background="#C42B1C" Width="26" Height="26" CornerRadius="13" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="pressedBg" Background="#902118" Width="26" Height="26" CornerRadius="13" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBg" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleIconPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#969696"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Stroke" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="normalBorder" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4"/>
                            <Border x:Name="hoverBorder" Background="#1E60B4" BorderBrush="#2B76D6" BorderThickness="1" CornerRadius="4" Opacity="0"/>
                            <Border x:Name="pressedBorder" Background="#15427D" BorderBrush="#1E4E8C" BorderThickness="1" CornerRadius="4" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBorder" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="PopupMenuItemStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="hoverBg" Background="#1E60B4" CornerRadius="4" Opacity="0"/>
                            <Border x:Name="pressedBg" Background="#15427D" CornerRadius="4" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverBg" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBg" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="SwitchBorder" Width="38" Height="20" CornerRadius="10" BorderThickness="1" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#252529"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#3E3E42"/>
                                </Border.BorderBrush>
                                <Ellipse x:Name="SwitchKnob" Width="14" Height="14" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="#969696"/>
                                    </Ellipse.Fill>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobTranslate" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="SwitchBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1E60B4" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="SwitchBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2B76D6" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="SwitchKnob" Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="SwitchBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#252529" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="SwitchBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#3E3E42" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="SwitchKnob" Storyboard.TargetProperty="(Ellipse.Fill).(SolidColorBrush.Color)" To="#969696" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#18181C">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#2F2F34"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" />
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Background="#1E1E24" CornerRadius="7,7,0,0" Height="6" ClipToBounds="True" MouseDown="TitleBar_MouseDown">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TitleBar" Storyboard.TargetProperty="Height" To="36" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetName="TitleBarContent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TitleBar" Storyboard.TargetProperty="Height" To="6" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetName="TitleBarContent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid x:Name="TitleBarContent" Opacity="0" Height="36" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Click="btnLogo_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="18" Height="18" Margin="0,0,5,0">
                                    <Grid Width="200" Height="200">
                                        <Path Data="{StaticResource AtomOrbitPath}" Stroke="#3690FF" StrokeThickness="8" />
                                        <Path Data="{StaticResource AtomOrbitPath}" Stroke="#3690FF" StrokeThickness="8">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="60" CenterX="100" CenterY="100"/>
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path Data="{StaticResource AtomOrbitPath}" Stroke="#3690FF" StrokeThickness="8">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="-60" CenterX="100" CenterY="100"/>
                                            </Path.RenderTransform>
                                        </Path>
                                        <Ellipse Width="44" Height="44" Fill="#FF1500" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="Sastral" Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="btnMinimize_Click">
                            <Path Style="{StaticResource TitleIconPathStyle}" Data="M 0,5 L 10,5"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="btnMaximize_Click">
                            <Path Style="{StaticResource TitleIconPathStyle}" Data="M 1,1 L 9,1 L 9,9 L 1,9 Z"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="btnClose_Click">
                            <Path Style="{StaticResource TitleIconPathStyle}" Data="M 1,1 L 9,9 M 1,9 L 9,1"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="#1E1E1E" x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="TerminalRow" Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="LoadingScreen" Grid.Row="0" Visibility="Visible" Opacity="1" Background="#18181C" ZIndex="100">
                    <Grid.Resources>
                        <Storyboard x:Key="LoadingAnimation">
                            <DoubleAnimation Storyboard.TargetName="LogoContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1.02" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="LogoContainer" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1.02" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <MatrixAnimationUsingPath Storyboard.TargetName="E1Transform" Storyboard.TargetProperty="Matrix" PathGeometry="{StaticResource AtomOrbitPath}" Duration="0:0:3" RepeatBehavior="Forever" DoesRotateWithTangent="False"/>
                            <MatrixAnimationUsingPath Storyboard.TargetName="E2Transform" Storyboard.TargetProperty="Matrix" PathGeometry="{StaticResource AtomOrbitPath}" Duration="0:0:3" RepeatBehavior="Forever" DoesRotateWithTangent="False"/>
                            <MatrixAnimationUsingPath Storyboard.TargetName="E3Transform" Storyboard.TargetProperty="Matrix" PathGeometry="{StaticResource AtomOrbitPath}" Duration="0:0:3" RepeatBehavior="Forever" DoesRotateWithTangent="False"/>
                            <DoubleAnimation Storyboard.TargetName="LoadingText" Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="MeowText" Storyboard.TargetProperty="Opacity" From="0.3" To="0.8" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Grid.Resources>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid x:Name="LogoContainer" Width="200" Height="200" Margin="0,0,0,25" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                            </Grid.RenderTransform>
                            <Path Data="{StaticResource AtomOrbitPath}" Stroke="#3690FF" StrokeThickness="5" />
                            <Path Data="{StaticResource AtomOrbitPath}" Stroke="#3690FF" StrokeThickness="5" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="60"/>
                                </Path.RenderTransform>
                            </Path>
                            <Path Data="{StaticResource AtomOrbitPath}" Stroke="#3690FF" StrokeThickness="5" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-60"/>
                                </Path.RenderTransform>
                            </Path>
                            <Ellipse Width="44" Height="44" Fill="#FF1500" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FF1500" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Electron1" Width="12" Height="12" Fill="#FFFFFF" Margin="-6,-6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Ellipse.RenderTransform>
                                    <MatrixTransform x:Name="E1Transform" Matrix="1,0,0,1,100,10"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Grid x:Name="Electron2" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="60"/>
                                </Grid.RenderTransform>
                                <Ellipse Width="12" Height="12" Fill="#FFFFFF" Margin="-6,-6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Ellipse.RenderTransform>
                                        <MatrixTransform x:Name="E2Transform" Matrix="1,0,0,1,100,10"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <Grid x:Name="Electron3" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="-60"/>
                                </Grid.RenderTransform>
                                <Ellipse Width="12" Height="12" Fill="#FFFFFF" Margin="-6,-6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Ellipse.RenderTransform>
                                        <MatrixTransform x:Name="E3Transform" Matrix="1,0,0,1,100,10"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="LoadingText" Text="Loading" Foreground="#E0E0E0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock x:Name="MeowText" Text="meow..." Foreground="#A0A0A0" FontSize="11" HorizontalAlignment="Center" Opacity="0.8"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="HomeContainer" Grid.Row="0" Visibility="Collapsed" Opacity="0" Background="#18181C">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
                            <Grid Width="50" Height="50" ToolTip="Double-click to change photo. Drag to move/pan image.">
                                <Ellipse Fill="#252529" Stroke="#3E3E42" StrokeThickness="1"/>
                                <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      Fill="#7A7A80" Stretch="Uniform" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="ProfileAvatar" Cursor="Hand"
                                         MouseLeftButtonDown="ProfileAvatar_MouseLeftButtonDown"
                                         MouseMove="ProfileAvatar_MouseMove"
                                         MouseLeftButtonUp="ProfileAvatar_MouseLeftButtonUp">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ProfileBrush" Stretch="UniformToFill">
                                            <ImageBrush.RelativeTransform>
                                                <TranslateTransform x:Name="ProfileBrushTranslate" X="0" Y="0"/>
                                            </ImageBrush.RelativeTransform>
                                        </ImageBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <TextBox x:Name="ProfileNickname" Text="Nickname" Foreground="#FFFFFF" CaretBrush="#FFFFFF"
                                     FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"
                                     TextChanged="ProfileNickname_TextChanged" MaxWidth="250" ToolTip="Edit Nickname">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4" Padding="4">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1E1E24"/>
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="Background" Value="#252529"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Left">
                            <TextBlock x:Name="ClockText" Text="00:00:00" Foreground="#FFFFFF" FontSize="48" FontWeight="Light"/>
                            <TextBlock x:Name="DateText" Text="Loading Date..." Foreground="#A0A0A0" FontSize="16" Margin="4,0,0,0"/>
                            <TextBlock x:Name="WeatherText" Text="⛅ Loading weather..." Foreground="#E0E0E0" FontSize="18" FontWeight="Normal" Margin="4,8,0,30" FontFamily="Segoe UI Emoji, Segoe UI"/>

                            <TextBlock x:Name="WelcomeText" Text="Welcome!" Foreground="#FFFFFF" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="4,0,0,15"/>

                            <Border Background="#1E1E24" CornerRadius="8" BorderBrush="#2F2F34" BorderThickness="1" Padding="20" Width="320" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="QUOTE OF THE DAY" Foreground="#7A7A80" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="QuoteText" Text="Code is poetry." Foreground="#A0A0A0" FontSize="14" FontStyle="Italic" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="EditorContainer" Grid.Row="0" Visibility="Collapsed" Opacity="0">
                    <Wpf:WebView2 Name="Editor" Margin="0"/>
                </Grid>

                <Grid x:Name="ScriptContainer" Grid.Row="0" Visibility="Collapsed" Opacity="0">
                    <Wpf:WebView2 Name="Script" Margin="0"/>
                </Grid>

                <Grid x:Name="SettingsContainer" Grid.Row="0" Visibility="Collapsed" Opacity="0" Background="#18181C">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,20">
                            <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                            <Border Background="#1E1E24" CornerRadius="8" BorderBrush="#2F2F34" BorderThickness="1" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="GENERAL" Foreground="#7A7A80" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <CheckBox x:Name="ToggleTopMost" Style="{StaticResource ToggleSwitchStyle}" Content="Always on Top" Click="ToggleTopMost_Click" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ToggleAutoAttach" Style="{StaticResource ToggleSwitchStyle}" Content="Auto Attach" Click="ToggleAutoAttach_Click" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ToggleFastLoading" Style="{StaticResource ToggleSwitchStyle}" Content="Fast Loading" Click="ToggleFastLoading_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border x:Name="TerminalContainer" Grid.Row="1" Background="#0C0C0E" Height="0" Visibility="Collapsed" ClipToBounds="True" BorderThickness="0,1,0,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1E60B4" Offset="0"/>
                            <GradientStop Color="#2B76D6" Offset="0.5"/>
                            <GradientStop Color="#1E60B4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Wpf:WebView2 x:Name="TerminalWebView" Margin="0"/>
                </Border>

                <Popup x:Name="SidePanelPopup" Grid.Row="0" AllowsTransparency="True" PopupAnimation="Fade" Placement="Top"
                       PlacementTarget="{Binding ElementName=MenuTriggerButton}" StaysOpen="True"
                       VerticalOffset="-4" HorizontalOffset="-6"
                       MouseEnter="SidePanelPopup_MouseEnter" MouseLeave="SidePanelPopup_MouseLeave">
                    <Grid Margin="10">
                        <Border Background="#252529" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="4" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="12" ShadowDepth="4" Direction="270"/>
                            </Border.Effect>

                            <StackPanel Width="120">
                                <Button Style="{StaticResource PopupMenuItemStyle}" Click="btnSelectHome_Click" Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Home" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PopupMenuItemStyle}" Click="btnSelectEditor_Click" Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Editor" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PopupMenuItemStyle}" Click="btnSelectScript_Click" Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Scripts" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="#3E3E42" Margin="6,4,6,6"/>
                                <Button Style="{StaticResource PopupMenuItemStyle}" Click="btnSelectSettings_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>

            <Border x:Name="BottomStatusBar" Grid.Row="2" Background="#1E1E24" CornerRadius="0,0,7,7" BorderThickness="0,1,0,0" BorderBrush="#2F2F34">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="MenuTriggerButton" Style="{StaticResource IconButtonStyle}" ToolTip="Menu" MouseEnter="MenuTriggerButton_MouseEnter" MouseLeave="MenuTriggerButton_MouseLeave" Click="MenuTriggerButton_Click">
                        <Path Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Border Grid.Column="1" Width="1" Height="16" Background="#3E3E42" Margin="12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="RobloxStatusDot" Width="8" Height="8" Fill="#FF4747" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RobloxStatusText" Text="Roblox: Closed" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,1"/>
                    </StackPanel>
                    <Border Grid.Column="3" Width="1" Height="16" Background="#3E3E42" Margin="12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="AttachStatusDot" Width="8" Height="8" Fill="#FF4747" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AttachStatusText" Text="Not Attached" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Click="btnKillRoblox_Click" Margin="0,0,8,0" ToolTip="Kill Roblox">
                            <Path Data="M 5.86 0 L 24 4.31 L 18.14 24 L 0 19.69 L 5.86 0 Z M 11.02 9.54 L 14.86 10.45 L 13.95 14.29 L 10.11 13.38 L 11.02 9.54 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="btnAttach_Click" Margin="0,0,8,0" ToolTip="Attach">
                            <Path Data="M3.9,12 C3.9,10.29 5.29,8.9 7,8.9 L11,8.9 L11,7 L7,7 C4.24,7 2,9.24 2,12 C2,14.76 4.24,17 7,17 L11,17 L11,15.1 L7,15.1 C5.29,15.1 3.9,13.71 3.9,12 Z M8,13 L16,13 L16,11 L8,11 L8,13 Z M17,7 L13,7 L13,8.9 L17,8.9 C18.71,8.9 20.1,10.29 20.1,12 C20.1,13.71 18.71,15.1 17,15.1 L13,15.1 L13,17 L17,17 C19.76,17 22,14.76 22,12 C22,9.24 19.76,7 17,7 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="btnOpen_Click" Margin="0,0,8,0" ToolTip="Open File">
                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="btnSave_Click" Margin="0,0,8,0" ToolTip="Save File">
                            <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="btnAuto_Click" Margin="0,0,8,0" ToolTip="AutoExec (Save)">
                            <Path Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="btnClear_Click" Margin="0,0,8,0" ToolTip="Clear Editor">
                            <Path Data="M15 4V3H9V4H4V6H5V19C5 20.1 5.9 21 7 21H17C18.1 21 19 20.1 19 19V6H20V4H15ZM17 19H7V6H17V19ZM9 8H11V17H9V8ZM13 8H15V17H13V8Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Button>

                        <Button x:Name="btnToggleTerminal" Style="{StaticResource IconButtonStyle}" Click="btnToggleTerminal_Click" Margin="0,0,8,0" ToolTip="Toggle Terminal">
                            <Path Data="M 3,4 L 10,11 L 3,18 H 6 L 12.5,11 L 6,4 Z M 11,16 H 20 V 18 H 11 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        </Button>

                        <Button Style="{StaticResource IconButtonStyle}" Click="btnExecute_Click" ToolTip="Execute Code">
                            <Path Data="M 2,1 L 11,6 L 2,11 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="2,0,0,0" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
