<Window x:Class="Sastral.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sastral" Height="600" Width="900" 
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="hoverBg" Background="#1E60B4" Width="26" Height="26" CornerRadius="13" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="pressedBg" Background="#15427D" Width="26" Height="26" CornerRadius="13" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hoverBg" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBg" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="hoverBg" Background="#C42B1C" Width="26" Height="26" CornerRadius="13" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="pressedBg" Background="#902118" Width="26" Height="26" CornerRadius="13" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hoverBg" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBg" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleIconPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#969696"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Button}, Path=IsMouseOver}" Value="True">
                    <Setter Property="Stroke" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="normalBorder" 
                                    Background="#2D2D30" 
                                    BorderBrush="#3E3E42" 
                                    BorderThickness="1" 
                                    CornerRadius="4"/>
                            <Border x:Name="hoverBorder" 
                                    Background="#1E60B4" 
                                    BorderBrush="#2B76D6" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Opacity="0"/>
                            <Border x:Name="pressedBorder" 
                                    Background="#15427D" 
                                    BorderBrush="#1E4E8C" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hoverBorder" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBorder" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"/>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="normalBorder" 
                                    Background="#2D2D30" 
                                    BorderBrush="#3E3E42" 
                                    BorderThickness="1" 
                                    CornerRadius="10"/>
                            <Border x:Name="hoverBorder" 
                                    Background="#1E60B4" 
                                    BorderBrush="#2B76D6" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Opacity="0"/>
                            <Border x:Name="pressedBorder" 
                                    Background="#15427D" 
                                    BorderBrush="#1E4E8C" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hoverBorder" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBorder" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoadingProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="#252529"/>
            <Setter Property="Foreground" Value="#1E60B4"/>
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" Height="4">
                            <Border x:Name="PART_Track" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Border x:Name="RootBorder" Background="#18181C">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#2F2F34"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                        <Setter Property="CornerRadius" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" />
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Background="#1E1E24" CornerRadius="7,7,0,0" Height="6" ClipToBounds="True" MouseDown="TitleBar_MouseDown">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TitleBar"
                                                 Storyboard.TargetProperty="Height" 
                                                 To="36" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="TitleBarContent" 
                                                 Storyboard.TargetProperty="Opacity" 
                                                 To="1" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>

                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TitleBar"
                                                 Storyboard.TargetProperty="Height" 
                                                 To="6" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseIn"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="TitleBarContent" 
                                                 Storyboard.TargetProperty="Opacity" 
                                                 To="0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseIn"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid x:Name="TitleBarContent" Opacity="0" Height="36" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Click="btnLogo_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Sastral.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,5,0"/>
                                <TextBlock Text="Sastral" Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="btnMinimize_Click">
                            <Path Style="{StaticResource TitleIconPathStyle}" Data="M 0,5 L 10,5"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="btnMaximize_Click">
                            <Path Style="{StaticResource TitleIconPathStyle}" Data="M 1,1 L 9,1 L 9,9 L 1,9 Z"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="btnClose_Click">
                            <Path Style="{StaticResource TitleIconPathStyle}" Data="M 1,1 L 9,9 M 1,9 L 9,1"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="#1E1E1E" x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        x:Name="LeftGutter"
                        Width="8"
                        Height="90"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseEnter="LeftGutter_MouseEnter"
                        MouseLeave="LeftGutter_MouseLeave"
                        MouseLeftButtonDown="LeftGutter_MouseLeftButtonDown"/>

                <Grid Grid.Column="1">
                    <Grid x:Name="LoadingScreen" Visibility="Visible" Opacity="1" Background="#18181C" ZIndex="100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Image Source="Sastral.png" Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.95"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Loading" Foreground="#E0E0E0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="3" Text="meow..." Foreground="#A0A0A0" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    </Grid>

                    <Grid x:Name="EditorContainer" Visibility="Visible" Opacity="1">
                        <Wpf:WebView2 Name="Editor" Margin="0"/>
                    </Grid>

                    <Grid x:Name="ScriptContainer" Visibility="Collapsed" Opacity="0">
                        <Wpf:WebView2 Name="Script" Margin="0"/>
                    </Grid>
                </Grid>

                <Popup x:Name="SidePanelPopup"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Placement="Right"
                       PlacementTarget="{Binding ElementName=LeftGutter}"
                       StaysOpen="True"
                       MouseEnter="SidePanelPopup_MouseEnter"
                       MouseLeave="SidePanelPopup_MouseLeave">

                    <Border Background="#1E1E24" 
                            BorderBrush="#2F2F34" 
                            BorderThickness="1" 
                            CornerRadius="0,8,8,0" 
                            Padding="6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True">
                        <StackPanel>

                            <Button Style="{StaticResource SidebarButtonStyle}" 
                                    Click="btnSelectEditor_Click"
                                    Margin="0,0,0,6"
                                    ToolTip="Editor">
                                <Path Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Button>

                            <Button Style="{StaticResource SidebarButtonStyle}" 
                                    Click="btnSelectScript_Click"
                                    ToolTip="Script">
                                <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Border x:Name="BottomStatusBar" Grid.Row="2" Background="#1E1E24" CornerRadius="0,0,7,7" BorderThickness="0,1,0,0" BorderBrush="#2F2F34">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse x:Name="RobloxStatusDot" Width="8" Height="8" Fill="#FF4747" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RobloxStatusText" Text="Roblox: Closed" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>

                        <Border Width="1" Height="12" Background="#3E3E42" Margin="16,0"/>

                        <Ellipse x:Name="AttachStatusDot" Width="8" Height="8" Fill="#FF4747" Margin="0,0,8,0"/>
                        <TextBlock x:Name="AttachStatusText" Text="Not Attached" Foreground="#A0A0A0" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionButtonStyle}" Click="btnAttach_Click" Margin="0,0,8,0" Width="100">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M10.85,3 C9.68,1.83 7.78,1.83 6.61,3 L1.66,7.95 C0.1,9.51 0.1,12.05 1.66,13.61 C3.22,15.17 5.76,15.17 7.32,13.61 L12.27,8.66 C13.44,7.49 13.44,5.59 12.27,4.42 C11.1,3.25 9.2,3.25 8.03,4.42 L3.79,8.66 L4.5,9.37 L8.74,5.13 C9.52,4.35 10.78,4.35 11.56,5.13 C12.34,5.91 12.34,7.17 11.56,7.95 L6.61,12.9 C5.44,14.07 3.54,14.07 2.37,12.9 C1.2,11.73 1.2,9.83 2.37,8.66 L7.32,3.71 C8.1,2.93 9.36,2.93 10.14,3.71 C10.92,4.49 10.92,5.75 10.14,6.53 L5.55,11.12 L6.26,11.83 L10.85,7.24 C12.02,6.07 12.02,4.17 10.85,3 Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                      Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Attach" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryActionButtonStyle}" Click="btnExecute_Click" Width="110">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2,1 L 11,6 L 2,11 Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                      Width="10" Height="10" Stretch="Uniform" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Execute" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
